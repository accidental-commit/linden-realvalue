{
  "manifest_version": 3,
  "name": "Linden RealValue - SL Marketplace Converter",
  "version": "1.0.2",
  "description": "Displays estimated real-world currency value next to Linden Dollar (L$) prices on Second Life Marketplace using live LindeX rates.",
  "browser_specific_settings": {
    "gecko": {
      "id": "linden-realvalue@accidental-commit",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.secondlife.com/*",
    "https://open.er-api.com/*",
    "https://marketplace.secondlife.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://marketplace.secondlife.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Linden RealValue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

